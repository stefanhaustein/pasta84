  begin
    -1
  while
    xkey -> c
    c 0 = if cr return then
    c 10 = c 13 = or if cr return then
    c 8 = c 127 = or if
      __linelen 0 > if
        __linelen 1 - -> __linelen
        8 xemit 32 xemit 8 xemit
      then
    else
      c 32 >= __linelen 255 < and if
        c __linebuf __linelen a+ i8!
        __linelen 1 + -> __linelen
        c xemit
      then
    then
  repeat
end

